diff --git a/src/lib/components/workflow/workflow-chat.svelte b/src/lib/components/workflow/workflow-chat.svelte
new file mode 100644
index 0000000..212c365
--- /dev/null
+++ b/src/lib/components/workflow/workflow-chat.svelte
@@ -0,0 +1,315 @@
+<script lang="ts">
+  import { untrack } from 'svelte';
+
+  import { page } from '$app/state';
+
+  import { IconCodex, IconSpinner } from '$lib/io/icon';
+  import WorkflowChatMessage from '$lib/components/workflow/workflow-chat-message.svelte';
+  import { getQuery } from '$lib/services/query-service';
+
+  type WorkingItem = { kind: string; text: string };
+  type Turn = {
+    id: string;
+    turnId?: string;
+    input: string;
+    output: string;
+    working: WorkingItem[];
+    status: 'queued' | 'running' | 'completed' | 'failed';
+    updatedAt: number;
+  };
+  type Conversation = {
+    id: string;
+    threadId?: string;
+    stage: string;
+    role: string;
+    turns: Turn[];
+    updatedAt: number;
+  };
+  type Snapshot = { conversations: Conversation[]; cursor: number };
+  type ExecutionStatus = {
+    phase?: string;
+    status?: string;
+    active_spec?: string;
+    active_ticket?: string;
+    pending_reason?: string;
+    next_action?: string;
+    retry_count?: number;
+    deadline?: string;
+    last_error?: string;
+  };
+
+  let conversations = $state<Conversation[]>([]);
+  let loading = $state(true);
+  let connection = $state('connecting');
+  let executionStatus = $state<ExecutionStatus | undefined>();
+  const conversationOrigin = 'http://127.0.0.1:18001';
+  const emptyMessage = $derived(
+    executionStatus?.phase === 'planning'
+      ? 'Planning is in progress. No Codex conversation has started yet.'
+      : executionStatus?.phase === 'spec_publication'
+        ? 'Publishing SPECs. No Codex conversation has started yet.'
+        : executionStatus?.phase === 'tickets'
+          ? 'Preparing tickets. No Codex conversation has been recorded yet.'
+          : executionStatus?.status === 'completed'
+            ? 'This execution completed without recorded Codex conversations.'
+            : executionStatus?.status === 'failed' ||
+                executionStatus?.status === 'blocked'
+              ? 'This execution stopped before a Codex conversation was recorded.'
+              : 'No Codex conversation has been recorded for this execution yet.',
+  );
+
+  $effect(() => {
+    const { namespace, workflow: workflowId, run: runId } = page.params;
+    return untrack(() => {
+      conversations = [];
+      executionStatus = undefined;
+      loading = true;
+      connection = 'connecting';
+      const controller = new AbortController();
+      const parameters = new URLSearchParams({
+        namespace,
+        workflow_id: workflowId,
+        run_id: runId,
+      });
+      const endpoint = `${conversationOrigin}/api/v1/codex/conversations?${parameters}`;
+      const streamEndpoint = `${conversationOrigin}/api/v1/codex/stream?${parameters}`;
+      let stream: EventSource | undefined;
+      let retryTimer: ReturnType<typeof setTimeout> | undefined;
+      let statusTimer: ReturnType<typeof setTimeout> | undefined;
+      let attempts = 0;
+      let cursor = -1;
+
+      const applySnapshot = (snapshot: Snapshot) => {
+        if (
+          !Array.isArray(snapshot.conversations) ||
+          !Number.isFinite(snapshot.cursor)
+        ) {
+          throw new Error('Invalid conversation snapshot');
+        }
+        if (controller.signal.aborted || snapshot.cursor < cursor) return;
+        cursor = snapshot.cursor;
+        conversations = snapshot.conversations;
+        loading = false;
+      };
+
+      const recover = () => {
+        if (controller.signal.aborted || retryTimer) return;
+        stream?.close();
+        loading = false;
+        connection = 'reconnecting';
+        const delay = Math.min(1000 * 2 ** attempts++, 15000);
+        retryTimer = setTimeout(() => {
+          retryTimer = undefined;
+          void load();
+        }, delay);
+      };
+
+      const subscribe = () => {
+        stream?.close();
+        stream = new EventSource(streamEndpoint);
+        stream.addEventListener('open', () => {
+          if (!controller.signal.aborted) {
+            connection = 'connected';
+            attempts = 0;
+          }
+        });
+        stream.addEventListener('error', recover);
+        stream.addEventListener('conversations', (event) => {
+          try {
+            applySnapshot(JSON.parse((event as MessageEvent).data) as Snapshot);
+          } catch {
+            recover();
+          }
+        });
+      };
+
+      const load = async () => {
+        try {
+          const response = await fetch(endpoint, { signal: controller.signal });
+          if (!response.ok)
+            throw new Error(`Conversation service returned ${response.status}`);
+          applySnapshot((await response.json()) as Snapshot);
+          if (!controller.signal.aborted) subscribe();
+        } catch {
+          recover();
+        }
+      };
+
+      const pollStatus = async () => {
+        try {
+          const status = await getQuery(
+            {
+              namespace,
+              workflow: { id: workflowId, runId },
+              queryType: 'get_status',
+            },
+            controller.signal,
+          );
+          if (
+            !controller.signal.aborted &&
+            status &&
+            typeof status === 'object' &&
+            !Array.isArray(status)
+          ) {
+            executionStatus = status as ExecutionStatus;
+          }
+        } catch {
+          // Ordinary Temporal workflows may not expose the Codex status query.
+        }
+        if (!controller.signal.aborted)
+          statusTimer = setTimeout(() => void pollStatus(), 5000);
+      };
+
+      void load();
+      void pollStatus();
+      return () => {
+        controller.abort();
+        stream?.close();
+        clearTimeout(retryTimer);
+        clearTimeout(statusTimer);
+      };
+    });
+  });
+</script>
+
+<section class="flex min-h-[28rem] flex-col gap-6" data-testid="workflow-chat">
+  {#if executionStatus}
+    <div
+      class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-secondary"
+      data-testid="execution-status"
+      aria-live="polite"
+    >
+      <span
+        >{executionStatus.phase ?? 'Codex'} · {executionStatus.status ??
+          'running'}</span
+      >
+      {#if executionStatus.active_spec}<span
+          >SPEC: {executionStatus.active_spec}</span
+        >{/if}
+      {#if executionStatus.active_ticket}<span
+          >Ticket: {executionStatus.active_ticket}</span
+        >{/if}
+      {#if executionStatus.pending_reason}<span
+          >{executionStatus.pending_reason}</span
+        >{/if}
+      {#if executionStatus.next_action}<span
+          >Next: {executionStatus.next_action}</span
+        >{/if}
+      {#if executionStatus.retry_count}<span
+          >Retry: {executionStatus.retry_count}</span
+        >{/if}
+      {#if executionStatus.deadline}<span
+          >Deadline: {executionStatus.deadline}</span
+        >{/if}
+      {#if executionStatus.last_error}<span>{executionStatus.last_error}</span
+        >{/if}
+    </div>
+  {/if}
+  {#if connection === 'reconnecting'}
+    <div
+      role="status"
+      class="border-l-2 border-primary px-4 py-2 text-sm text-secondary"
+    >
+      Conversation service unavailable. Reconnecting automatically.
+    </div>
+  {/if}
+  {#if loading}
+    <div class="flex items-center gap-2 py-12 text-sm text-secondary">
+      <IconSpinner class="h-4 w-4 animate-spin" /> Loading conversation history...
+    </div>
+  {:else if conversations.length === 0}
+    <div
+      class="border border-dashed border-primary px-6 py-12 text-center text-sm text-secondary"
+    >
+      {emptyMessage}
+    </div>
+  {:else}
+    <div class="flex flex-col gap-10">
+      {#each conversations as conversation (conversation.id)}
+        <article
+          class="flex flex-col gap-6"
+          data-thread-id={conversation.threadId ?? conversation.id}
+        >
+          <div class="flex items-center gap-3 border-b border-primary pb-3">
+            <span
+              class="flex h-8 w-8 items-center justify-center rounded-full bg-surface-secondary text-primary"
+            >
+              <IconCodex class="h-4 w-4" />
+            </span>
+            <div class="min-w-0">
+              <div class="font-medium text-primary">{conversation.role}</div>
+              <div class="truncate font-mono text-xs text-secondary">
+                {conversation.threadId ?? 'thread pending'} · {conversation.stage}
+              </div>
+            </div>
+          </div>
+
+          {#each conversation.turns as turn (turn.id)}
+            <div class="flex flex-col gap-5">
+              {#if turn.input}
+                <div class="flex justify-end">
+                  <div
+                    class="min-w-0 max-w-3xl rounded-lg bg-surface-secondary px-4 py-3 text-sm leading-6 text-primary"
+                  >
+                    <div
+                      class="mb-2 text-[11px] font-medium uppercase tracking-wide text-secondary"
+                    >
+                      Workflow input
+                    </div>
+                    <WorkflowChatMessage content={turn.input} />
+                  </div>
+                </div>
+              {/if}
+
+              {#if turn.working.length}
+                <details class="max-w-3xl text-sm text-secondary">
+                  <summary class="cursor-pointer select-none"
+                    >Working details</summary
+                  >
+                  <div
+                    class="mt-3 flex flex-col gap-3 border-l border-primary pl-4"
+                  >
+                    {#each turn.working as item}
+                      <div>
+                        <div
+                          class="mb-1 text-[11px] font-medium uppercase tracking-wide"
+                        >
+                          {item.kind}
+                        </div>
+                        <pre
+                          class="whitespace-pre-wrap break-words font-sans leading-6">{item.text}</pre>
+                      </div>
+                    {/each}
+                  </div>
+                </details>
+              {/if}
+
+              {#if turn.output}
+                <div class="flex gap-3">
+                  <span
+                    class="mt-1 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-surface-secondary text-primary"
+                  >
+                    <IconCodex class="h-4 w-4" />
+                  </span>
+                  <div class="min-w-0 max-w-4xl text-sm leading-7 text-primary">
+                    <div
+                      class="mb-2 text-[11px] font-medium uppercase tracking-wide text-secondary"
+                    >
+                      Codex
+                    </div>
+                    <WorkflowChatMessage content={turn.output} />
+                    {#if turn.status === 'running'}
+                      <span
+                        class="mt-2 inline-block h-4 w-1 animate-pulse bg-content-primary"
+                      ></span>
+                    {/if}
+                  </div>
+                </div>
+              {/if}
+            </div>
+          {/each}
+        </article>
+      {/each}
+    </div>
+  {/if}
+</section>
