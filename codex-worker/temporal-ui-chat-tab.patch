+  }
+
+  .chat-markdown :global(ul),
+  .chat-markdown :global(ol) {
+    margin: 0.75rem 0;
+    padding-left: 1.5rem;
+  }
+
+  .chat-markdown :global(ul) {
+    list-style: disc;
+  }
+
+  .chat-markdown :global(ol) {
+    list-style: decimal;
