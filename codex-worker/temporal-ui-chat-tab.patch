+<script lang="ts">
+  import { process, render } from '$lib/utilities/render-markdown';
+
+  let { content }: { content: string } = $props();
+  let html = $state('');
+
+  $effect(() => {
+    let active = true;
+    void process(content)
+      .then(render)
+      .then((value) => {
+        if (active) html = value;
+      });
+    return () => {
+      active = false;
+    };
+  });
+</script>
+
+<div class="chat-markdown overflow-wrap-anywhere min-w-0">{@html html}</div>
+
+<style>
+  .chat-markdown :global(p) {
+    margin: 0 0 0.375rem;
+  }
+
+  .chat-markdown :global(p:last-child) {
+    margin-bottom: 0;
+  }
+
+  .chat-markdown :global(h1),
+  .chat-markdown :global(h2),
+  .chat-markdown :global(h3) {
+    margin: 0.5rem 0 0.25rem;
+    font-weight: 600;
+    line-height: 1.3;
+  }
+
+  .chat-markdown :global(h1) {
+    font-size: 1.5rem;
+  }
+
+  .chat-markdown :global(h2) {
+    font-size: 1.25rem;
+  }
+
+  .chat-markdown :global(ul),
+  .chat-markdown :global(ol) {
+    margin: 0.375rem 0;
+    padding-left: 1.5rem;
+  }
+
+  .chat-markdown :global(ul) {
+    list-style: disc;
+  }
+
+  .chat-markdown :global(ol) {
+    list-style: decimal;
+  }
+
+  .chat-markdown :global(li) {
+    margin: 0.125rem 0;
+  }
+
+  .chat-markdown :global(pre) {
+    margin: 0.375rem 0;
+    overflow-x: auto;
+    border: 1px solid var(--color-border-secondary);
+    border-radius: 0.5rem;
+    background: var(--color-surface-secondary);
+    padding: 0.75rem;
+    white-space: pre;
+  }
+
+  .chat-markdown :global(code) {
+    border-radius: 0.25rem;
+    background: var(--color-surface-secondary);
+    padding: 0.1rem 0.25rem;
+    font-family: monospace;
+  }
+
+  .chat-markdown :global(pre code) {
+    background: none;
+    padding: 0;
+  }
+
+  .chat-markdown :global(a) {
+    color: var(--color-content-brand);
+    text-decoration: underline;
+  }
+
+  .chat-markdown :global(blockquote) {
+    margin: 0.375rem 0;
+    border-left: 3px solid var(--color-border-brand);
+    padding-left: 0.75rem;
+  }
+
+  .chat-markdown :global(table) {
+    display: block;
+    max-width: 100%;
+    overflow-x: auto;
+    border-collapse: collapse;
+  }
+
+  .chat-markdown :global(th),
+  .chat-markdown :global(td) {
+    border: 1px solid var(--color-border-secondary);
+    padding: 0.375rem 0.75rem;
+  }
+</style>
diff --git a/src/lib/components/workflow/workflow-chat.svelte b/src/lib/components/workflow/workflow-chat.svelte
new file mode 100644
index 0000000..2a97925
--- /dev/null
+++ b/src/lib/components/workflow/workflow-chat.svelte
@@ -0,0 +1,1055 @@
+<script lang="ts">
+  import { untrack } from 'svelte';
+
+  import { page } from '$app/state';
+
+  import WorkflowChatMessage from '$lib/components/workflow/workflow-chat-message.svelte';
+  import {
+    IconCheckCircle,
+    IconClock,
+    IconCodex,
+    IconFileImport,
+    IconSpinner,
+    IconTerminal,
+    IconWarning,
+    IconXmarkCircleSolid,
+  } from '$lib/io/icon';
+  import { getQuery } from '$lib/services/query-service';
+  import { workflowRun } from '$lib/stores/workflow-run';
+
+  type WorkingItem = { kind: string; text: string };
+  type Activity = {
+    id: string;
+    groupedIds?: string[];
+    category: string;
+    summary: string;
+    commandName?: string;
+    text: string;
+    hasDetails?: boolean;
+    detail?: Record<string, unknown> | Record<string, unknown>[];
+  };
+  type TimelineMessage =
+    | { type: 'user' | 'assistant'; text: string }
+    | { type: 'activity'; activity: Activity };
+  type Turn = {
+    id: string;
+    turnId?: string;
+    input: string;
+    output: string;
+    displayOutput?: string;
+    verificationMarkers?: string[];
+    activities?: Activity[];
+    messages?: TimelineMessage[];
+    working?: WorkingItem[];
+    status: 'queued' | 'running' | 'completed' | 'failed';
+    updatedAt: number;
+  };
+  type Conversation = {
+    id: string;
+    threadId?: string;
+    stage: string;
+    role: string;
+    turns: Turn[];
+    updatedAt: number;
+  };
+  type Snapshot = { conversations: Conversation[]; cursor: number };
+  type ExecutionStatus = {
+    phase?: string;
+    status?: string;
+    active_spec?: string;
+    active_ticket?: string;
+    pending_reason?: string;
+    next_action?: string;
+    retry_count?: number;
+    deadline?: string;
+    last_error?: string;
+  };
+
+  const stageTitle = (stage: string) =>
+    stage
+      .replace(/[_-]+/g, ' ')
+      .replace(/\b\w/g, (letter) => letter.toUpperCase());
+
+  const errorSummary = (error: string) =>
+    error.split(/\r?\n/, 1)[0].slice(0, 160);
+
+  const turnActivities = (turn: Turn): Activity[] =>
+    turn.activities ??
+    (turn.working ?? []).map((item, index) => ({
+      id: `legacy:${index}`,
+      category: item.kind.startsWith('tool')
+        ? 'tool'
+        : item.kind.startsWith('plan')
+          ? 'plan'
+          : 'reasoning',
+      summary: item.kind.startsWith('tool')
+        ? 'Tool activity recorded'
+        : item.kind.startsWith('plan')
+          ? 'Plan updated'
+          : 'Progress update recorded',
+      text: item.text,
+    }));
+
+  const groupAdjacentActivities = (messages: TimelineMessage[]) => {
+    const grouped: TimelineMessage[] = [];
+    for (const message of messages) {
+      const previous = grouped.at(-1);
+      if (
+        message.type === 'activity' &&
+        previous?.type === 'activity' &&
+        previous.activity.category === message.activity.category
+      ) {
+        const groupedIds = [
+          ...(previous.activity.groupedIds ?? [previous.activity.id]),
+          ...(message.activity.groupedIds ?? [message.activity.id]),
+        ];
+        grouped[grouped.length - 1] = {
+          type: 'activity',
+          activity: {
+            ...previous.activity,
+            groupedIds,
+            summary: [previous.activity.summary, message.activity.summary]
+              .filter(Boolean)
+              .join('\n'),
+            commandName: [
+              previous.activity.commandName ?? previous.activity.summary,
+              message.activity.commandName ?? message.activity.summary,
+            ].join('\n'),
+            text: '',
+            hasDetails: Boolean(
+              previous.activity.hasDetails ||
+              previous.activity.text ||
+              previous.activity.detail ||
+              message.activity.hasDetails ||
+              message.activity.text ||
+              message.activity.detail,
+            ),
+          },
+        };
+      } else {
+        grouped.push(message);
+      }
+    }
+    return grouped;
+  };
+
+  const turnMessages = (turn: Turn): TimelineMessage[] => {
+    const messages = turn.messages?.length
+      ? turn.messages
+      : [
+          ...(turn.input ? [{ type: 'user' as const, text: turn.input }] : []),
+          ...turnActivities(turn)
+            .filter((activity) => activity.category !== 'verification')
+            .map((activity) => ({ type: 'activity' as const, activity })),
+          ...((turn.displayOutput ?? turn.output)
+            ? [
+                {
+                  type: 'assistant' as const,
+                  text: turn.displayOutput ?? turn.output,
+                },
+              ]
+            : []),
+        ];
+    return groupAdjacentActivities(messages);
+  };
+
+  const activityIcon = (category: string) =>
+    category === 'context' || category === 'file'
+      ? IconFileImport
+      : category === 'test' || category === 'verification'
+        ? IconCheckCircle
+        : category === 'command' || category === 'tool'
+          ? IconTerminal
+          : category === 'error'
+            ? IconWarning
+            : IconClock;
+
+  const testResult = (activity: Activity) => {
+    const results = activity.summary.split('\n').map((summary) => {
+      if (
+        /\bFailed\s*\(exit\s+-?\d+\)|\b[1-9]\d*\s+(?:failed|errors?)\b/i.test(
+          summary,
+        )
+      ) {
+        return 'failed';
+      }
+      if (/\bPassed\s*\(exit\s+0\)/i.test(summary)) return 'passed';
+      return 'unknown';
+    });
+    if (results.includes('failed')) return 'failed';
+    return results.length > 0 && results.every((result) => result === 'passed')
+      ? 'passed'
+      : 'unknown';
+  };
+
+  const detailLabel = (category: string) =>
+    category === 'context'
+      ? 'Detail'
+      : category === 'error'
+        ? 'Error details'
+        : category === 'file'
+          ? 'File details'
+          : 'Recorded output';
+
+  const isCompactActivity = (category: string) =>
+    category === 'context' || category === 'command' || category === 'test';
+
+  const activityCategoryColor = (category: string) =>
+    category === 'context'
+      ? 'text-information'
+      : category === 'command'
+        ? 'text-brand'
+        : category === 'test'
+          ? 'text-success'
+          : 'text-secondary';
+
+  const activityDetailRecords = (activity: Activity) =>
+    Array.isArray(activity.detail)
+      ? activity.detail
+      : activity.detail
+        ? [activity.detail]
+        : [];
+
+  const commandForActivity = (activity: Activity) =>
+    activityDetailRecords(activity).find(
+      (detail) =>
+        typeof detail.command === 'string' && detail.command.trim().length > 0,
+    )?.command ?? activity.summary;
+
+  const briefActivitySummary = (activity: Activity) => {
+    const lines = (
+      activity.category === 'context'
+        ? activity.summary
+        : (activity.commandName ?? activity.summary)
+    )
+      .split('\n')
+      .map((line) => {
+        if (activity.category === 'context') {
+          return line.replace(/^(?:Read context:|Read)\s*/i, '').trim();
+        }
+        const executable = line
+          .trim()
+          .match(/^(?:"([^"]+)"|'([^']+)'|([^\s]+))/);
+        const name =
+          (executable?.[1] ?? executable?.[2] ?? executable?.[3] ?? '')
+            .split(/[\\/]/)
+            .filter(Boolean)
+            .at(-1) ?? '';
+        if (/\.{3,}$/.test(name)) return 'Command';
+        return name.length > 24 ? `${name.slice(0, 21)}...` : name;
+      })
+      .filter(Boolean);
+    const unique = [...new Set(lines)];
+    if (activity.category === 'context') return `Read ${unique.join(', ')}`;
+    return (
+      unique.slice(0, 2).join(' · ') +
+      (unique.length > 2 ? ` (+${unique.length - 2})` : '')
+    );
+  };
+
+  const outputForActivity = (activity: Activity) =>
+    activityDetailRecords(activity).find(
+      (detail) =>
+        typeof detail.aggregated_output === 'string' &&
+        detail.aggregated_output.length > 0,
+    )?.aggregated_output ?? activity.text;
+
+  const jsonDocuments = (content: string): unknown[] | undefined => {
+    const trimmed = content.trim();
+    if (!trimmed) return undefined;
+    try {
+      return [JSON.parse(trimmed) as unknown];
+    } catch {
+      const documents: unknown[] = [];
+      let start = -1;
+      let depth = 0;
+      let inString = false;
+      let escaped = false;
+      for (let index = 0; index < trimmed.length; index += 1) {
+        const character = trimmed[index];
+        if (start < 0) {
+          if (/\s/.test(character)) continue;
+          if (character !== '{') return undefined;
+          start = index;
+          depth = 1;
+          continue;
+        }
+        if (inString) {
+          if (escaped) escaped = false;
+          else if (character === '\\') escaped = true;
+          else if (character === '"') inString = false;
+          continue;
+        }
+        if (character === '"') inString = true;
+        else if (character === '{' || character === '[') depth += 1;
+        else if (character === '}' || character === ']') depth -= 1;
+        if (depth === 0) {
+          try {
+            documents.push(
+              JSON.parse(trimmed.slice(start, index + 1)) as unknown,
+            );
+          } catch {
+            return undefined;
+          }
+          start = -1;
+        }
+      }
+      return start < 0 && documents.length > 0 ? documents : undefined;
+    }
+  };
+
+  type ReviewDocument = {
+    candidate_sha: string;
+    findings: string[];
+    verdict: string;
+  };
+
+  const reviewDocuments = (content: string): ReviewDocument[] | undefined => {
+    const documents = jsonDocuments(content);
+    if (
+      !documents?.length ||
+      !documents.every((document) => {
+        if (
+          document === null ||
+          typeof document !== 'object' ||
+          Array.isArray(document)
+        ) {
+          return false;
+        }
+        const record = document as Record<string, unknown>;
+        return (
+          typeof record.candidate_sha === 'string' &&
+          Array.isArray(record.findings) &&
+          record.findings.every((finding) => typeof finding === 'string') &&
+          typeof record.verdict === 'string'
+        );
+      })
+    ) {
+      return undefined;
+    }
+    return documents.map((document) => {
+      const record = document as Record<string, unknown>;
+      return {
+        candidate_sha: record.candidate_sha as string,
+        findings: record.findings as string[],
+        verdict: record.verdict as string,
+      };
+    });
+  };
+
+  const reviewFindingState = (finding: string) =>
+    /not yet completed|not completed|incomplete/i.test(finding)
+      ? 'incomplete'
+      : /in progress/i.test(finding)
+        ? 'active'
+        : 'pending';
+
+  const reviewFindings = (reviews: ReviewDocument[]) => [
+    ...new Set(reviews.flatMap((review) => review.findings)),
+  ];
+
+  const terminalExecutionStatuses = new Set([
+    'completed',
+    'failed',
+    'blocked',
+    'cancelled',
+    'canceled',
+    'terminated',
+    'timed_out',
+    'timeout',
+  ]);
+
+  const turnIsActive = (turn: Turn, execution: string | undefined) =>
+    turn.status === 'running' &&
+    !(execution && terminalExecutionStatuses.has(execution.toLowerCase()));
+
+  const turnLabel = (status: Turn['status'], execution: string | undefined) =>
+    status === 'running' &&
+    execution &&
+    terminalExecutionStatuses.has(execution.toLowerCase())
+      ? 'Stopped'
+      : status === 'running'
+        ? 'In progress'
+        : status === 'failed'
+          ? 'Failed'
+          : status === 'queued'
+            ? 'Queued'
+            : 'Completed';
+
+  let conversations = $state<Conversation[]>([]);
+  let expandedTurns = $state<Record<string, Turn>>({});
+  let loadingDetails = $state<Record<string, boolean>>({});
+  let activeScope = '';
+  let loading = $state(true);
+  let connection = $state('connecting');
+  let executionStatus = $state<ExecutionStatus | undefined>();
+  const conversationOrigin = 'http://127.0.0.1:18001';
+  const workflowType = $derived($workflowRun.workflow?.name ?? '');
+  const utilityWorkflow = $derived(
+    [
+      'RequirementPlanningWorkflow',
+      'DeliveryWorkflow',
+      'DeliverySummaryWorkflow',
+    ].includes(workflowType),
+  );
+  const parentChatUrl = $derived.by(() => {
+    const parent = $workflowRun.workflow?.parent;
+    if (!parent?.workflowId || !parent.runId) return '';
+    return `/namespaces/${encodeURIComponent(page.params.namespace)}/workflows/${encodeURIComponent(parent.workflowId)}/${encodeURIComponent(parent.runId)}/chat`;
+  });
+  const statusQueries: Record<string, string> = {
+    RequirementDeliveryWorkflow: 'get_whole_flow_status',
+    SpecExecutionWorkflow: 'get_whole_flow_status',
+    TicketSchedulerWorkflow: 'get_scheduler_status',
+    RequirementPlanningWorkflow: 'get_planning_status',
+    DeliveryWorkflow: 'get_delivery_status',
+    DeliverySummaryWorkflow: 'get_summary_publication_status',
+  };
+  const emptyMessage = $derived(
+    utilityWorkflow
+      ? 'This historical execution contains orchestration activities. Agent conversations belong to its parent execution.'
+      : executionStatus?.phase === 'planning'
+        ? 'Planning is in progress. No Codex conversation has started yet.'
+        : executionStatus?.phase === 'spec_publication'
+          ? 'Publishing SPECs. No Codex conversation has started yet.'
+          : executionStatus?.phase === 'tickets'
+            ? 'Preparing tickets. No Codex conversation has been recorded yet.'
+            : executionStatus?.status === 'completed'
+              ? 'This execution completed without recorded Codex conversations.'
+              : executionStatus?.status === 'failed' ||
+                  executionStatus?.status === 'blocked'
+                ? 'This execution stopped before a Codex conversation was recorded.'
+                : 'No Codex conversation has been recorded for this execution yet.',
+  );
+
+  const loadTurnDetails = async (turn: Turn) => {
+    if (expandedTurns[turn.id] || loadingDetails[turn.id]) return;
+    loadingDetails = { ...loadingDetails, [turn.id]: true };
+    const { namespace, workflow: workflowId, run: runId } = page.params;
+    const scope = `${namespace}:${workflowId}:${runId}`;
+    const parameters = new URLSearchParams({
+      namespace,
+      workflow_id: workflowId,
+      run_id: runId,
+      view: 'thread',
+      details: '1',
+    });
+    try {
+      const response = await fetch(
+        `${conversationOrigin}/api/v1/codex/conversations?${parameters}`,
+      );
+      if (!response.ok) throw new Error('Conversation details unavailable');
+      const snapshot = (await response.json()) as Snapshot;
+      if (activeScope !== scope) return;
+      const fullTurn = snapshot.conversations
+        .flatMap((conversation) => conversation.turns)
+        .find((candidate) => candidate.id === turn.id);
+      if (fullTurn) expandedTurns = { ...expandedTurns, [turn.id]: fullTurn };
+    } catch {
+      // Keep the compact thread readable when optional evidence is unavailable.
+    } finally {
+      if (activeScope === scope) {
+        const { [turn.id]: _, ...remaining } = loadingDetails;
+        loadingDetails = remaining;
+      }
+    }
+  };
+
+  $effect(() => {
+    const { namespace, workflow: workflowId, run: runId } = page.params;
+    activeScope = `${namespace}:${workflowId}:${runId}`;
+    return untrack(() => {
+      conversations = [];
+      expandedTurns = {};
+      loadingDetails = {};
+      executionStatus = undefined;
+      loading = true;
+      connection = 'connecting';
+      const controller = new AbortController();
+      const parameters = new URLSearchParams({
+        namespace,
+        workflow_id: workflowId,
+        run_id: runId,
+        view: 'thread',
+      });
+      const streamEndpoint = `${conversationOrigin}/api/v1/codex/stream?${parameters}`;
+      let stream: EventSource | undefined;
+      let retryTimer: ReturnType<typeof setTimeout> | undefined;
+      let statusTimer: ReturnType<typeof setTimeout> | undefined;
+      let attempts = 0;
+      let cursor = -1;
+
+      const applySnapshot = (snapshot: Snapshot) => {
+        if (
+          !Array.isArray(snapshot.conversations) ||
+          !Number.isFinite(snapshot.cursor)
+        ) {
+          throw new Error('Invalid conversation snapshot');
+        }
+        if (controller.signal.aborted || snapshot.cursor < cursor) return;
+        cursor = snapshot.cursor;
+        conversations = snapshot.conversations;
+        loading = false;
+      };
+
+      const recover = () => {
+        if (controller.signal.aborted || retryTimer) return;
+        stream?.close();
+        connection = 'reconnecting';
+        const delay = Math.min(1000 * 2 ** attempts++, 15000);
+        retryTimer = setTimeout(() => {
+          retryTimer = undefined;
+          subscribe();
+        }, delay);
+      };
+
+      const subscribe = () => {
+        stream?.close();
+        stream = new EventSource(streamEndpoint);
+        stream.addEventListener('open', () => {
+          if (!controller.signal.aborted) {
+            connection = 'connected';
+            attempts = 0;
+          }
+        });
+        stream.addEventListener('error', recover);
+        stream.addEventListener('conversations', (event) => {
+          try {
+            applySnapshot(JSON.parse((event as MessageEvent).data) as Snapshot);
+          } catch {
+            recover();
+          }
+        });
+      };
+
+      const pollStatus = async () => {
+        try {
+          const status = await getQuery(
+            {
+              namespace,
+              workflow: { id: workflowId, runId },
+              queryType: statusQueries[workflowType] ?? 'get_status',
+            },
+            controller.signal,
+          );
+          if (
+            !controller.signal.aborted &&
+            status &&
+            typeof status === 'object' &&
+            !Array.isArray(status)
+          ) {
+            executionStatus = status as ExecutionStatus;
+          }
+        } catch {
+          // Ordinary Temporal workflows may not expose the Codex status query.
+        }
+        if (!controller.signal.aborted)
+          statusTimer = setTimeout(() => void pollStatus(), 5000);
+      };
+
+      subscribe();
+      void pollStatus();
+      return () => {
+        controller.abort();
+        stream?.close();
+        clearTimeout(retryTimer);
+        clearTimeout(statusTimer);
+      };
+    });
+  });
+</script>
+
+<section class="flex min-h-[28rem] flex-col gap-3" data-testid="workflow-chat">
+  {#if executionStatus}
+    <div
+      class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-secondary"
+      data-testid="execution-status"
+      aria-live="polite"
+    >
+      <span
+        >{executionStatus.phase ?? 'Codex'} · {executionStatus.status ??
