+test('Chat keeps recorded messages through stream interruption and recovers automatically', async ({
+  page,
+}, testInfo) => {
+  test.setTimeout(30000);
+  const errors: string[] = [];
+  page.on('pageerror', (error) => errors.push(error.message));
+  await mockWorkflowApis(page, mockWorkflow);
+  let unavailable = false;
+  let recovered = false;
+  await page.route('http://127.0.0.1:18001/**', async (route) => {
+    const url = new URL(route.request().url());
+    if (unavailable) {
+      await route.fulfill({ status: 503, body: 'Unavailable' });
+    } else if (url.pathname.endsWith('/stream')) {
+      await route.fulfill({
+        contentType: 'text/event-stream',
+        body: `event: conversations\ndata: ${JSON.stringify(snapshot(recovered ? 'Recovered response' : 'Streamed response', recovered ? 3 : 2))}\n\n`,
+      });
+    } else {
+      await route.fulfill({
+        json: snapshot(
+          recovered ? 'Recovered response' : 'Recorded response',
+          recovered ? 3 : 1,
+        ),
+      });
+    }
+  });
+  await page.goto(workflowUrl);
+  await expect(
+    page.getByText('Streamed response', { exact: true }),
+  ).toBeVisible();
+  await expect(
+    page.getByText('Tool activity recorded', { exact: true }),
+  ).toBeVisible();
+  await page
+    .getByTestId('codex-activity')
+    .getByText('Recorded output', { exact: true })
+    .last()
+    .click();
+  await expect(page.getByText('Tests passed')).toBeVisible();
+  unavailable = true;
+  await expect(
+    page
+      .getByRole('status')
+      .filter({ hasText: 'Conversation service unavailable' }),
+  ).toBeVisible();
+  await expect(
+    page.getByText('Streamed response', { exact: true }),
+  ).toBeVisible();
+  unavailable = false;
+  recovered = true;
+  await expect(
+    page.getByText('Recovered response', { exact: true }),
+  ).toBeVisible();
+  await expect(
+    page.getByText('Implement the selected ticket', { exact: true }),
+  ).toHaveCount(1);
+  await page.screenshot({
+    path: testInfo.outputPath('chat-recovered.png'),
+    fullPage: true,
+  });
+  expect(errors).toEqual([]);
+});
