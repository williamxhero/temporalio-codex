diff --git a/src/lib/components/workflow/workflow-chat.svelte b/src/lib/components/workflow/workflow-chat.svelte
new file mode 100644
index 0000000..145235f
--- /dev/null
+++ b/src/lib/components/workflow/workflow-chat.svelte
@@ -0,0 +1,509 @@
+<script lang="ts">
+  import { untrack } from 'svelte';
+
+  import { page } from '$app/state';
+
+  import {
+    IconCodex,
+    IconSpinner,
+    IconTerminal,
+    IconFileImport,
+    IconCheckCircle,
+    IconClock,
+    IconWarning,
+  } from '$lib/io/icon';
+  import WorkflowChatMessage from '$lib/components/workflow/workflow-chat-message.svelte';
+  import { getQuery } from '$lib/services/query-service';
+
+  type WorkingItem = { kind: string; text: string };
+  type Activity = {
+    id: string;
+    category: string;
+    summary: string;
+    text: string;
+    detail?: Record<string, unknown>;
+  };
+  type Turn = {
+    id: string;
+    turnId?: string;
+    input: string;
+    output: string;
+    displayOutput?: string;
+    verificationMarkers?: string[];
+    activities?: Activity[];
+    working?: WorkingItem[];
+    status: 'queued' | 'running' | 'completed' | 'failed';
+    updatedAt: number;
+  };
+  type Conversation = {
+    id: string;
+    threadId?: string;
+    stage: string;
+    role: string;
+    turns: Turn[];
+    updatedAt: number;
+  };
+  type Snapshot = { conversations: Conversation[]; cursor: number };
+  type ExecutionStatus = {
+    phase?: string;
+    status?: string;
+    active_spec?: string;
+    active_ticket?: string;
+    pending_reason?: string;
+    next_action?: string;
+    retry_count?: number;
+    deadline?: string;
+    last_error?: string;
+  };
+
+  const stageTitle = (stage: string) =>
+    stage
+      .replace(/[_-]+/g, ' ')
+      .replace(/\b\w/g, (letter) => letter.toUpperCase());
+
+  const errorSummary = (error: string) =>
+    error.split(/\r?\n/, 1)[0].slice(0, 160);
+
+  const turnActivities = (turn: Turn): Activity[] =>
+    turn.activities ??
+    (turn.working ?? []).map((item, index) => ({
+      id: `legacy:${index}`,
+      category: item.kind.startsWith('tool')
+        ? 'tool'
+        : item.kind.startsWith('plan')
+          ? 'plan'
+          : 'reasoning',
+      summary: item.kind.startsWith('tool')
+        ? 'Tool activity recorded'
+        : item.kind.startsWith('plan')
+          ? 'Plan updated'
+          : 'Progress update recorded',
+      text: item.text,
+    }));
+
+  const activityIcon = (category: string) =>
+    category === 'context' || category === 'file'
+      ? IconFileImport
+      : category === 'test' || category === 'verification'
+        ? IconCheckCircle
+        : category === 'command' || category === 'tool'
+          ? IconTerminal
+          : category === 'error'
+            ? IconWarning
+            : IconClock;
+
+  const detailLabel = (category: string) =>
+    category === 'context'
+      ? 'Context source'
+      : category === 'error'
+        ? 'Error details'
+        : category === 'command' || category === 'test'
+          ? 'Command output'
+          : category === 'file'
+            ? 'File details'
+            : 'Recorded output';
+
+  const turnLabel = (status: Turn['status']) =>
+    status === 'running'
+      ? 'In progress'
+      : status === 'failed'
+        ? 'Failed'
+        : status === 'queued'
+          ? 'Queued'
+          : 'Completed';
+
+  let conversations = $state<Conversation[]>([]);
+  let loading = $state(true);
+  let connection = $state('connecting');
+  let executionStatus = $state<ExecutionStatus | undefined>();
+  const conversationOrigin = 'http://127.0.0.1:18001';
+  const emptyMessage = $derived(
+    executionStatus?.phase === 'planning'
+      ? 'Planning is in progress. No Codex conversation has started yet.'
+      : executionStatus?.phase === 'spec_publication'
+        ? 'Publishing SPECs. No Codex conversation has started yet.'
+        : executionStatus?.phase === 'tickets'
+          ? 'Preparing tickets. No Codex conversation has been recorded yet.'
+          : executionStatus?.status === 'completed'
+            ? 'This execution completed without recorded Codex conversations.'
+            : executionStatus?.status === 'failed' ||
+                executionStatus?.status === 'blocked'
+              ? 'This execution stopped before a Codex conversation was recorded.'
+              : 'No Codex conversation has been recorded for this execution yet.',
+  );
+
+  $effect(() => {
+    const { namespace, workflow: workflowId, run: runId } = page.params;
+    return untrack(() => {
+      conversations = [];
+      executionStatus = undefined;
+      loading = true;
+      connection = 'connecting';
+      const controller = new AbortController();
+      const parameters = new URLSearchParams({
+        namespace,
+        workflow_id: workflowId,
+        run_id: runId,
+      });
+      const endpoint = `${conversationOrigin}/api/v1/codex/conversations?${parameters}`;
+      const streamEndpoint = `${conversationOrigin}/api/v1/codex/stream?${parameters}`;
+      let stream: EventSource | undefined;
+      let retryTimer: ReturnType<typeof setTimeout> | undefined;
+      let statusTimer: ReturnType<typeof setTimeout> | undefined;
+      let attempts = 0;
+      let cursor = -1;
+
+      const applySnapshot = (snapshot: Snapshot) => {
+        if (
+          !Array.isArray(snapshot.conversations) ||
+          !Number.isFinite(snapshot.cursor)
+        ) {
+          throw new Error('Invalid conversation snapshot');
+        }
+        if (controller.signal.aborted || snapshot.cursor < cursor) return;
+        cursor = snapshot.cursor;
+        conversations = snapshot.conversations;
+        loading = false;
+      };
+
+      const recover = () => {
+        if (controller.signal.aborted || retryTimer) return;
+        stream?.close();
+        loading = false;
+        connection = 'reconnecting';
+        const delay = Math.min(1000 * 2 ** attempts++, 15000);
+        retryTimer = setTimeout(() => {
+          retryTimer = undefined;
+          void load();
+        }, delay);
+      };
+
+      const subscribe = () => {
+        stream?.close();
+        stream = new EventSource(streamEndpoint);
+        stream.addEventListener('open', () => {
+          if (!controller.signal.aborted) {
+            connection = 'connected';
+            attempts = 0;
+          }
+        });
+        stream.addEventListener('error', recover);
+        stream.addEventListener('conversations', (event) => {
+          try {
+            applySnapshot(JSON.parse((event as MessageEvent).data) as Snapshot);
+          } catch {
+            recover();
+          }
+        });
+      };
+
+      const load = async () => {
+        try {
+          const response = await fetch(endpoint, { signal: controller.signal });
+          if (!response.ok)
+            throw new Error(`Conversation service returned ${response.status}`);
+          applySnapshot((await response.json()) as Snapshot);
+          if (!controller.signal.aborted) subscribe();
+        } catch {
+          recover();
+        }
+      };
+
+      const pollStatus = async () => {
+        try {
+          const status = await getQuery(
+            {
+              namespace,
+              workflow: { id: workflowId, runId },
+              queryType: 'get_status',
+            },
+            controller.signal,
+          );
+          if (
+            !controller.signal.aborted &&
+            status &&
+            typeof status === 'object' &&
+            !Array.isArray(status)
+          ) {
+            executionStatus = status as ExecutionStatus;
+          }
+        } catch {
+          // Ordinary Temporal workflows may not expose the Codex status query.
+        }
+        if (!controller.signal.aborted)
+          statusTimer = setTimeout(() => void pollStatus(), 5000);
+      };
+
+      void load();
+      void pollStatus();
+      return () => {
+        controller.abort();
+        stream?.close();
+        clearTimeout(retryTimer);
+        clearTimeout(statusTimer);
+      };
+    });
+  });
+</script>
+
+<section class="flex min-h-[28rem] flex-col gap-6" data-testid="workflow-chat">
+  {#if executionStatus}
+    <div
+      class="flex flex-wrap gap-x-4 gap-y-1 text-sm text-secondary"
+      data-testid="execution-status"
+      aria-live="polite"
+    >
+      <span
+        >{executionStatus.phase ?? 'Codex'} · {executionStatus.status ??
+          'running'}</span
+      >
+      {#if executionStatus.active_spec}<span
+          >SPEC: {executionStatus.active_spec}</span
+        >{/if}
+      {#if executionStatus.active_ticket}<span
+          >Ticket: {executionStatus.active_ticket}</span
+        >{/if}
+      {#if executionStatus.pending_reason}<span
+          >{executionStatus.pending_reason}</span
+        >{/if}
+      {#if executionStatus.next_action}<span
+          >Next: {executionStatus.next_action}</span
+        >{/if}
+      {#if executionStatus.retry_count}<span
+          >Retry: {executionStatus.retry_count}</span
+        >{/if}
+      {#if executionStatus.deadline}<span
+          >Deadline: {executionStatus.deadline}</span
+        >{/if}
+      {#if executionStatus.last_error}
+        <div class="min-w-0">
+          <span class="activity-summary"
+            >{errorSummary(executionStatus.last_error)}</span
+          >
+          <details class="mt-1 text-xs">
+            <summary class="cursor-pointer select-none">Error details</summary>
+            <pre class="raw-output mt-2">{executionStatus.last_error}</pre>
+          </details>
+        </div>
+      {/if}
+    </div>
+  {/if}
+  {#if connection === 'reconnecting'}
+    <div
+      role="status"
+      class="border-l-2 border-primary px-4 py-2 text-sm text-secondary"
+    >
+      Conversation service unavailable. Reconnecting automatically.
+    </div>
+  {/if}
+  {#if loading}
+    <div class="flex items-center gap-2 py-12 text-sm text-secondary">
+      <IconSpinner class="h-4 w-4 animate-spin" /> Loading conversation history...
+    </div>
+  {:else if conversations.length === 0}
+    <div
+      class="border border-dashed border-primary px-6 py-12 text-center text-sm text-secondary"
+    >
+      {emptyMessage}
+    </div>
+  {:else}
+    <div class="flex flex-col gap-12">
+      {#each conversations as conversation (conversation.id)}
+        <article
+          class="flex flex-col gap-6"
+          data-thread-id={conversation.threadId ?? conversation.id}
+        >
+          <header
+            class="flex flex-wrap items-start gap-3 border-b border-primary pb-4"
+          >
+            <span
+              class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-surface-secondary text-primary"
+            >
+              <IconCodex class="h-4 w-4" />
+            </span>
+            <div class="min-w-0 flex-1">
+              <h2 class="text-base font-semibold text-primary">
+                {stageTitle(conversation.stage)}
+              </h2>
+              <div class="mt-1 text-sm text-secondary">
+                {conversation.role} · {conversation.turns.length}
+                {conversation.turns.length === 1 ? ' turn' : ' turns'}
+              </div>
+            </div>
+            <details class="min-w-0 text-xs text-secondary">
+              <summary class="cursor-pointer select-none"
+                >Thread details</summary
+              >
+              <div class="mt-2 max-w-56 break-all font-mono">
+                <div>Stage: {conversation.stage}</div>
+                <div>Thread: {conversation.threadId ?? 'thread pending'}</div>
+                <div>Operation: {conversation.id}</div>
+              </div>
+            </details>
+          </header>
+
+          {#each conversation.turns as turn, turnIndex (turn.id)}
+            <section class="flex flex-col gap-4" data-testid="codex-turn">
+              <div
+                class="flex items-center justify-between gap-3 text-xs text-secondary"
+              >
+                <span class="font-medium uppercase tracking-wide"
+                  >Turn {turnIndex + 1}</span
+                >
+                <div class="flex flex-wrap items-center justify-end gap-3">
+                  <span>{turnLabel(turn.status)}</span>
+                  <details class="min-w-0">
+                    <summary class="cursor-pointer select-none"
+                      >Turn details</summary
+                    >
+                    <div class="mt-2 max-w-56 break-all font-mono">
+                      {turn.turnId ?? turn.id}
+                    </div>
+                  </details>
+                </div>
+              </div>
+
+              {#if turn.input}
+                <details
+                  class="max-w-4xl text-sm text-secondary"
+                  data-testid="codex-prompt"
+                >
+                  <summary class="cursor-pointer select-none"
+                    >Prompt · implementation context</summary
+                  >
+                  <div
+                    class="mt-3 min-w-0 border-l border-primary pl-4 leading-6 text-primary"
+                  >
+                    <WorkflowChatMessage content={turn.input} />
+                  </div>
+                </details>
+              {/if}
+
+              {#if turnActivities(turn).length}
+                <ol
+                  class="flex min-w-0 max-w-4xl flex-col gap-4 border-l border-primary pl-4 text-sm"
+                  data-testid="codex-activity"
+                  aria-label="Activity timeline"
+                >
+                  {#each turnActivities(turn).filter((activity) => activity.category !== 'verification') as activity (activity.id)}
+                    {@const ActivityIcon = activityIcon(activity.category)}
+                    <li class="flex min-w-0 gap-3">
+                      <ActivityIcon
+                        class="mt-0.5 h-4 w-4 shrink-0 text-secondary"
+                      />
+                      <div class="min-w-0 flex-1">
+                        <div class="mb-0.5 text-xs text-secondary">
+                          {stageTitle(activity.category)}
+                        </div>
+                        <p class="activity-summary font-medium text-primary">
+                          {activity.category === 'error'
+                            ? errorSummary(activity.summary)
+                            : activity.summary}
+                        </p>
+                        {#if activity.text}
+                          <details class="mt-1 text-xs text-secondary">
+                            <summary class="cursor-pointer select-none"
+                              >{detailLabel(activity.category)}</summary
+                            >
+                            <pre
+                              class="raw-output mt-2 text-sm text-primary">{activity.text}</pre>
+                          </details>
+                        {/if}
+                        {#if activity.detail && Object.keys(activity.detail).length}
+                          <details class="mt-1 text-xs text-secondary">
+                            <summary class="cursor-pointer select-none"
+                              >Technical metadata</summary
+                            >
+                            <pre
+                              class="raw-output mt-2 text-sm text-primary">{JSON.stringify(
+                                activity.detail,
+                                null,
+                                2,
+                              )}</pre>
+                          </details>
+                        {/if}
+                      </div>
+                    </li>
+                  {/each}
+                </ol>
+              {/if}
+
+              {#if turn.displayOutput ?? turn.output}
+                <div class="flex gap-3" data-testid="codex-response">
+                  <span
+                    class="mt-1 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-surface-secondary text-primary"
+                  >
+                    <IconCodex class="h-4 w-4" />
+                  </span>
+                  <div
+                    class="min-w-0 max-w-4xl flex-1 text-sm leading-7 text-primary"
+                  >
+                    <div class="mb-2 text-sm font-semibold text-primary">
+                      Codex
+                    </div>
+                    <WorkflowChatMessage
+                      content={turn.displayOutput ?? turn.output}
+                    />
+                    {#if turn.status === 'running'}
+                      <span
+                        class="mt-2 inline-block h-4 w-1 animate-pulse bg-content-primary"
+                      ></span>
+                    {/if}
+                  </div>
+                </div>
+              {/if}
+              {#if (turn.verificationMarkers?.length ?? 0) || turnActivities(turn).some((activity) => activity.category === 'verification')}
+                <details
+                  class="min-w-0 max-w-4xl text-xs text-secondary"
+                  data-testid="codex-verification"
+                >
+                  <summary class="cursor-pointer select-none"
+                    >Verification details</summary
+                  >
+                  {#each turn.verificationMarkers ?? [] as marker}
+                    <pre class="raw-output mt-2">{marker}</pre>
+                  {/each}
+                  {#each turnActivities(turn).filter((activity) => activity.category === 'verification') as activity (activity.id)}
+                    <pre class="raw-output mt-2">{activity.text}</pre>
+                    {#if activity.detail && Object.keys(activity.detail).length}
+                      <details class="mt-1">
+                        <summary class="cursor-pointer select-none"
+                          >Technical metadata</summary
+                        >
+                        <pre class="raw-output mt-2">{JSON.stringify(
+                            activity.detail,
+                            null,
+                            2,
+                          )}</pre>
+                      </details>
+                    {/if}
+                  {/each}
+                </details>
+              {/if}
+              {#if !(turn.displayOutput ?? turn.output) && turn.status === 'running'}
+                <div
+                  class="flex items-center gap-3 text-sm text-secondary"
+                  role="status"
+                >
+                  <IconSpinner class="h-4 w-4 animate-spin" /> Codex is working…
+                </div>
+              {/if}
+            </section>
+          {/each}
+        </article>
+      {/each}
+    </div>
+  {/if}
+</section>
+
+<style>
+  .activity-summary,
+  .raw-output {
+    overflow-wrap: anywhere;
+  }
+
+  .raw-output {
+    max-width: 100%;
+    white-space: pre-wrap;
+  }
+</style>
