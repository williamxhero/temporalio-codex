+test('Chat discards the previous execution when navigating to another run', async ({
+  page,
+}) => {
+  await mockWorkflowApis(page, mockWorkflow);
+  const otherRun = '11111111-1111-4111-8111-111111111111';
+  const requests: URL[] = [];
+  await page.route('http://127.0.0.1:18001/**', async (route) => {
+    const url = new URL(route.request().url());
+    requests.push(url);
+    const current = url.searchParams.get('run_id') === otherRun;
+    const data = snapshot(
+      current ? 'New execution output' : 'Previous execution output',
+      1,
+    );
+    await respondWithSnapshot(route, data);
+  });
+  await page.goto(`${workflowUrl}/chat`);
+  await expect(
+    page.getByText('Previous execution output', { exact: true }),
+  ).toBeVisible();
+  await page.evaluate((url) => {
+    const link = document.createElement('a');
+    link.href = url;
+    link.textContent = 'Open another execution';
+    link.style.cssText =
+      'position:fixed;top:0;left:0;z-index:9999;background:white;padding:12px;';
+    document.body.append(link);
+  }, `/namespaces/default/workflows/${workflowId}/${otherRun}/chat`);
+  await page.getByRole('link', { name: 'Open another execution' }).click();
+  await expect(
+    page.getByText('New execution output', { exact: true }),
+  ).toBeVisible();
+  await expect(
+    page.getByText('Previous execution output', { exact: true }),
+  ).toHaveCount(0);
+  expect(
+    requests.some((url) => url.searchParams.get('run_id') === otherRun),
+  ).toBe(true);
+});
