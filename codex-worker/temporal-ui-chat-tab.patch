index 0000000..da581da
--- /dev/null
+++ b/scripts/build-server.mjs
@@ -0,0 +1,20 @@
+import { execFileSync } from 'node:child_process';
+
+const env = { ...process.env };
+env.VITE_API = '';
+env.BUILD_PATH = process.env.BUILD_PATH || 'server/ui/assets/local';
+env.VITE_TEMPORAL_UI_BUILD_TARGET = 'local';
+
+const command = process.env.npm_execpath
+  ? process.execPath
+  : process.platform === 'win32'
+    ? 'pnpm.cmd'
+    : 'pnpm';
+const args = process.env.npm_execpath
+  ? [process.env.npm_execpath, 'exec', 'vite', 'build']
+  : ['exec', 'vite', 'build'];
+
+execFileSync(command, args, {
+  env,
+  stdio: 'inherit',
+});
