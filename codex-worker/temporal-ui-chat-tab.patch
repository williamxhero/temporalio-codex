--- /dev/null
+++ b/tests/integration/workflow-chat.spec.ts
@@ -0,0 +1,182 @@
+import { expect, test } from '@playwright/test';
+
+import { mockWorkflowApis } from '~/test-utilities/mock-apis';
+import { mockWorkflow } from '~/test-utilities/mocks/workflow';
+
+const { workflowId, runId } = mockWorkflow.workflowExecutionInfo.execution;
+const workflowUrl = `/namespaces/default/workflows/${workflowId}/${runId}`;
+
+const snapshot = (output: string, cursor: number) => ({
+  cursor,
+  conversations: [
+    {
+      id: 'execution-turn',
+      threadId: 'thread-1',
+      stage: 'implement',
+      role: 'implementer',
+      updatedAt: 1,
+      turns: [
+        {
+          id: 'turn-1',
+          input: 'Implement the selected ticket',
+          output,
+          status: 'completed',
+          updatedAt: 1,
+          working: [
+            { kind: 'plan', text: 'Update the workflow' },
+            { kind: 'reasoning_summary', text: 'Use bounded retries' },
+            { kind: 'tool_output', text: 'Tests passed' },
+          ],
+        },
+      ],
+    },
+  ],
+});
+
+test('Chat keeps recorded messages through stream interruption and recovers automatically', async ({
+  page,
+}, testInfo) => {
+  test.setTimeout(30000);
+  const errors: string[] = [];
+  page.on('pageerror', (error) => errors.push(error.message));
+  await mockWorkflowApis(page, mockWorkflow);
+  let unavailable = false;
+  let recovered = false;
