+    } else if (url.pathname.endsWith('/stream')) {
+      await route.fulfill({
+        contentType: 'text/event-stream',
+        body: `event: conversations\ndata: ${JSON.stringify(snapshot(recovered ? 'Recovered response' : 'Streamed response', recovered ? 3 : 2, true))}\n\n`,
+      });
+    } else {
+      await route.fulfill({
+        json: snapshot(
+          recovered ? 'Recovered response' : 'Recorded response',
+          recovered ? 3 : 1,
+        ),
+      });
